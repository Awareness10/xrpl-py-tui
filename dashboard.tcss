/* XRPL Dashboard - OLED Theme */

/* Use pure black background */
Screen {
    background: $background;
}

#app-container {
    width: 100%;
    height: 100%;
    background: $background;
}

#top-bar {
    dock: top;
    height: auto;
}

#main-content {
    height: 1fr;
    padding: 0 1;
}

#left-panel {
    width: 50;
    margin-right: 1;
}

#right-panel {
    width: 1fr;
}

/* DataTable - minimal styling */
DataTable {
    height: 1fr;
    background: $surface;
}

DataTable > .datatable--header {
    text-style: bold;
    background: $panel;
}

DataTable > .datatable--cursor {
    background: $primary 25%;
}

DataTable:focus > .datatable--cursor {
    background: $primary 40%;
}
